{
  "name": "journey-planner",
  "private": true,
  "version": "1.0.0",
  "description": "Journey Planner - Salesforce unlocked package (Apex + LWC)",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "lint": "eslint --no-error-on-unmatched-pattern \"force-app/**/lwc/**/*.js\"",
    "prettier:verify": "prettier --check --no-error-on-unmatched-pattern \"force-app/**/*.{cls,trigger,js,html,xml,json}\"",
    "scan": "sf code-analyzer run --target force-app --view table --severity-threshold 2"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  }
}
